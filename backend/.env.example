# Optional Earthdata Login credentials for GRACE / GRACE-FO ice-sheet mass.
# If neither a token nor a username/password is set, sea level uses the
# labeled nasa-science-summary-fallback (−264 Gt/yr Greenland, −135 Gt/yr
# Antarctica). Never commit real values. Copy this file to backend/.env.

EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
